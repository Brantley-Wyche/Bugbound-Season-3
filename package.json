    "encode": "node scripts/encode.mjs",
    "custom-levels": "node scripts/custom-levels.mjs",
    "verify-level": "node scripts/verify-level.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
