{
  "name": "bugbound",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": "^11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "type": "module",
  "description": "Learn React by fixing it — a level-based debugging game where every lesson ships with a real bug.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src/shell src/components src/lib",
    "typecheck:components": "tsc -p tsconfig.components.json",
    "preview": "vite preview",
    "validate-levels": "node scripts/validate-levels.mjs",
    "encode": "node scripts/encode.mjs",
    "custom-levels": "node scripts/custom-levels.mjs",
    "verify-level": "node scripts/verify-level.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
